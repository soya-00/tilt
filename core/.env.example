# Tilt service configuration. Copy to .env and edit.
# The desktop shell injects these at spawn time; the API key is read from the
# macOS Keychain rather than a file in the real app.

# Where your journal lives. Markdown here is the source of truth.
TILT_DATA_DIR=~/Tilt

# auto | gemini | echo
#   auto  — Gemini when a key is present, otherwise the offline provider
#   echo  — always offline; useful for development and tests
TILT_PROVIDER=auto

# Leave unset to run fully offline with no spend.
# TILT_GEMINI_API_KEY=

# Model IDs are configuration, not constants: Flash releases move quickly and a
# scheduled job should not fail at 3am because a hardcoded string went stale.
TILT_GEMINI_MODEL=gemini-3.6-flash
TILT_GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Unattended work stops at 80% of this. Interactive calls always proceed.
TILT_MONTHLY_COST_CEILING_USD=20.0

TILT_CORS_ORIGINS=["http://localhost:5173"]
