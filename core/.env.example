# Tilt service configuration. Copy to .env and edit.
#
# Everything here is for running the service by hand. The desktop shell sets
# what it needs at spawn time and never writes a file: the host and port, the
# per-launch token, and the flag that ties the service's life to its own.

# Where your journal lives. Markdown here is the source of truth.
TILT_DATA_DIR=~/Tilt

# auto | gemini | echo
#   auto  — Gemini when a key is present, otherwise the offline provider
#   echo  — always offline; useful for development and tests
TILT_PROVIDER=auto

# Leave unset to run fully offline with no spend.
# TILT_GEMINI_API_KEY=

# Model IDs are configuration, not constants: Flash releases move quickly and a
# scheduled job should not fail at 3am because a hardcoded string went stale.
TILT_GEMINI_MODEL=gemini-3.6-flash
TILT_GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Unattended work stops at 80% of this. Interactive calls always proceed.
TILT_MONTHLY_COST_CEILING_USD=20.0

# The scheduled agents. Turn this off for an agent that acts only when asked.
TILT_SCHEDULE_ENABLED=true

# How often to look for entries nothing has filed yet — thoughts caught with
# ⌥Space while the window was closed, or written when a call failed. Costs one
# indexed query when the backlog is empty, which is nearly always.
TILT_SWEEP_INTERVAL_MINUTES=15

# Local hour for the nightly folder tidy. Overnight because it merges duplicate
# folders and retires quiet ones, and watching the sidebar rearrange itself
# under the cursor is unsettling.
TILT_THEME_KEEPER_HOUR=3

TILT_CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# Loopback only. Tilt is not a network service and should never be one.
TILT_HOST=127.0.0.1

# 0 asks the operating system for a free port. The shell uses that and reads
# the answer back; a fixed number is friendlier when you are running by hand.
TILT_PORT=8765

# When set, every request but /health must present this as a bearer token. The
# shell mints 32 random bytes per launch. Leave it unset to run open locally.
# TILT_AUTH_TOKEN=

# Shut down when stdin closes, so a crash in the desktop shell cannot leave a
# server running with your journal open. Only the shell sets this.
TILT_EXIT_WITH_PARENT=false
